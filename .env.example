# ─── Admin login ───────────────────────────────────────────────
# The credentials for /admin. Change these in production!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Fta@53009
# A long random string used to sign the admin session cookie.
AUTH_SECRET=change-me-to-a-long-random-string

# ─── Database (Neon Postgres) ──────────────────────────────────
# From your Neon project → Connection Details → connection string.
# If unset, the site uses a local JSON file (.data/versions.json) so you
# can develop without a database.
DATABASE_URL=postgres://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# ─── APK storage (Vercel Blob) ─────────────────────────────────
# From Vercel → Storage → Blob → connect, then pull env vars.
# If unset locally, uploaded APKs are saved to public/uploads/ instead.
BLOB_READ_WRITE_TOKEN=
